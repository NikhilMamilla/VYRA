# Copy to .env.local for local development:  cp .env.example .env.local
#
# Origin of the VYRA API. Vite inlines this at BUILD time, so changing it
# requires a restart (dev) or a rebuild (production).
#
# - Local development (backend on the host):  http://localhost:8000
# - Docker Compose:                           leave empty; nginx proxies /api
VITE_API_BASE_URL=http://localhost:8000
