# VYRA environment configuration.
#
# Copy to .env and edit as needed:   cp .env.example .env
# Everything here has a working default, so `docker compose up` runs without it.
# NEVER commit a filled-in .env -- it is git-ignored for that reason.

# --- Application -------------------------------------------------------------
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true emits one JSON object per log line

# Comma-separated browser origins allowed to call the API.
# Not needed for the Docker deployment, where nginx proxies /api same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
# Credentials for the local Postgres container started by docker-compose. This
# container has no published port (reachable only inside the compose network),
# so these are throwaway local defaults, not secrets. Change them for anything
# beyond a local demo.
POSTGRES_USER=vyra
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=vyra

# The backend builds its connection URL from DB_HOST / DB_USER / DB_PASSWORD /
# DB_NAME (DB_HOST defaults to "localhost" for host runs; compose sets it to
# "db"). Only set DATABASE_URL to override with a full async SQLAlchemy URL --
# e.g. an external / Supabase Postgres (swap the driver to asyncpg):
#   DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<db>
# DB_HOST=localhost
# DB_USER=vyra
# DB_PASSWORD=change-me-local-only
# DB_NAME=vyra
# DATABASE_URL=

# Phase 1 creates tables at startup. Set to false once migrations exist.
DATABASE_AUTO_CREATE=true

# --- Storage -----------------------------------------------------------------
# local     -> images on disk / in a Docker volume (the default)
# supabase  -> Supabase Storage (adapter not implemented yet)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/uploads

# Only required when STORAGE_BACKEND=supabase. Use the service_role key
# server-side and never expose it to the browser.
# SUPABASE_URL=https://<PROJECT-REF>.supabase.co
# SUPABASE_KEY=<service-role-key>
# SUPABASE_BUCKET=vyra-images

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760        # 10 MiB

# --- Model -------------------------------------------------------------------
# Directory of the VYRA inference bundle (model.joblib + calibrators.joblib +
# defect_detector.json + bundle.json). Defaults to the in-repo bundle; the
# Docker image bakes it in at /app/model. While unset the API reports the
# analyzer as not_configured and POST /api/v1/analyses returns 501.
# MODEL_PATH=ml/artifacts/vyra-quality-model-v1

# Fail startup if MODEL_PATH is set but the bundle cannot be loaded, instead of
# running the API without analysis. Recommended in production (Docker sets true).
REQUIRE_ANALYZER=false

# --- Ports (docker-compose) --------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
